{
  "targets": [
    "go",
    {
      "name": "npm",
      "path": "npm/"
    },
    {
      "name": "pypi",
      "path": "pypi/"
    }
  ],
  "private": false,
  "push_timeout": 120,
  "pipelines": {
    "go": {
      "type": "go",
      "local": false,
      "install_paths": [
        "."
      ],
      "custom_assets": [
        {
          "name": "conformance-tests.tar.gz",
          "build": "tar czf $RLSBL_DIST_DIR/conformance-tests.tar.gz -C conformance --exclude=*_test.go ."
        }
      ],
      "max_asset_size_mb": 10
    },
    "npm": {
      "type": "npm",
      "local": false,
      "provenance": true
    },
    "pypi": {
      "type": "pypi",
      "local": false
    }
  },
  "coverage_unit": "commit"
}
