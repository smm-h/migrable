.TH "MIGRABLE" "1" "May 2026" "migrable " ""

.SH NAME
migrable-completion-fish - Generate the autocompletion script for fish


.SH SYNOPSIS
\fBmigrable completion fish [flags]\fP


.SH DESCRIPTION
Generate the autocompletion script for the fish shell.

.PP
To load completions in your current shell session:

.EX
migrable completion fish | source
.EE

.PP
To load completions for every new session, execute once:

.EX
migrable completion fish > ~/.config/fish/completions/migrable.fish
.EE

.PP
You will need to start a new shell for this setup to take effect.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for fish

.PP
\fB--no-descriptions\fP[=false]
	disable completion descriptions


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB--config-dir\fP=""
	path to configuration directory

.PP
\fB--quiet\fP[=false]
	suppress non-error output

.PP
\fB--verbose\fP[=false]
	enable verbose output


.SH SEE ALSO
\fBmigrable-completion(1)\fP


