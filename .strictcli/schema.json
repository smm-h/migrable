{
  "commands": {
    "init": {
      "effect": "mutating",
      "help": "Scaffold migrable.toml and migrations directory",
      "name": "init"
    },
    "merge": {
      "args": [
        {
          "help": "target semver version for the migration",
          "name": "version"
        }
      ],
      "effect": "mutating",
      "help": "Combine next/ staging files into a versioned migration",
      "name": "merge"
    },
    "migrate": {
      "effect": "mutating",
      "flags": [
        {
          "default": false,
          "help": "roll back the most recently applied migration",
          "name": "rollback",
          "negatable": true,
          "type": "bool"
        }
      ],
      "help": "Run pending migrations",
      "name": "migrate"
    },
    "status": {
      "effect": "read_only",
      "help": "Show current version and pending migrations",
      "name": "status"
    },
    "validate": {
      "effect": "read_only",
      "help": "Validate migration files",
      "name": "validate"
    }
  },
  "defaults": {
    "app": {
      "commands": {},
      "config": false,
      "deprecated": {},
      "env_prefix": null,
      "global_flags": [],
      "groups": {},
      "tag_contracts": {}
    },
    "arg": {
      "choices": null,
      "default": null,
      "required": true,
      "type": "str",
      "variadic": false
    },
    "command": {
      "args": [],
      "constraints": [],
      "flags": [],
      "hidden": false,
      "interactive": false,
      "passthrough": false,
      "tags": []
    },
    "flag": {
      "choices": null,
      "default": null,
      "env": null,
      "env_separator": null,
      "hidden": false,
      "negatable": null,
      "repeatable": false,
      "short": null,
      "unique": false
    },
    "group": {
      "commands": {},
      "deprecated": {},
      "groups": {},
      "hidden": false,
      "tags": []
    },
    "schema_version": 1
  },
  "deprecated": {
    "man": "Use 'migrable --help' for command documentation."
  },
  "global_flags": [
    {
      "default": "",
      "help": "path to configuration directory",
      "name": "config-dir",
      "type": "str"
    }
  ],
  "help": "Declarative config file migrations for TOML",
  "name": "migrable",
  "project_id": "github.com/smm-h/migrable",
  "schema_version": 1,
  "version": "0.6.0"
}
